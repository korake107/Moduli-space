\@writefile{toc}{\contentsline {subsection}{\numberline {5.1.1}二重井戸ポテンシャルとトンネル効果}{48}{subsection.5.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces 量子力学のインスタントン。左：二重井戸ポテンシャル $V$（灰）と、ユークリッド化で現れる逆さのポテンシャル $-V$（青）。$-V$ の2つの山の頂上 $x = \pm a$ を結ぶ古典解がインスタントンである。右：その解 $x_{\text  {cl}}(\tau ) = a\tanh (\omega (\tau - \tau _0)/2)$。時刻 $\tau _0$ の近くで瞬間的に井戸から井戸へ移る。$\tau _0$ を動かしても作用は変わらず、これがモジュライ・パラメータである。}}{48}{figure.5.1}\protected@file@percent }
\newlabel{fig:double-well}{{5.1}{48}{量子力学のインスタントン。左：二重井戸ポテンシャル $V$（灰）と、ユークリッド化で現れる逆さのポテンシャル $-V$（青）。$-V$ の2つの山の頂上 $x = \pm a$ を結ぶ古典解がインスタントンである。右：その解 $x_{\text {cl}}(\tau ) = a\tanh (\omega (\tau - \tau _0)/2)$。時刻 $\tau _0$ の近くで瞬間的に井戸から井戸へ移る。$\tau _0$ を動かしても作用は変わらず、これがモジュライ・パラメータである。}{figure.5.1}{}}
