\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces K\"ahler錐（$h^{1,1} = 2$ の場合の模式図）。K\"ahler類 $J = v^1\omega _1 + v^2\omega _2$ は、すべての曲線・曲面の体積が正となる錐の内部を動く。錐の壁では、ある曲線の体積がゼロに潰れ、多様体の位相が変化しうる（フロップ転移など）。原点から遠ざかる方向は多様体全体を大きくする方向である。}}{74}{figure.7.2}\protected@file@percent }
\newlabel{fig:kahler-cone}{{7.2}{74}{K\"ahler錐（$h^{1,1} = 2$ の場合の模式図）。K\"ahler類 $J = v^1\omega _1 + v^2\omega _2$ は、すべての曲線・曲面の体積が正となる錐の内部を動く。錐の壁では、ある曲線の体積がゼロに潰れ、多様体の位相が変化しうる（フロップ転移など）。原点から遠ざかる方向は多様体全体を大きくする方向である。}{figure.7.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2.2}複素構造の変形（$\delta g_{\bar  {i}\bar  {j}}$）}{75}{subsection.7.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces 周期の模式図（トーラスの場合）。交叉数 $1$ の2つのサイクル $A$（赤）と $B$（青）の上で正則形式 $\Omega $ を積分したものが周期である。トーラスでは $\Omega = dz$ で、周期の比 $\tau = \DOTSI \intop \ilimits@ _B\Omega /\DOTSI \intop \ilimits@ _A\Omega $ が複素構造モジュライとなる。CY3では、$2(h^{2,1} + 1)$ 個の3サイクル $\{A_I, B^I\}$ の上で正則3形式を積分する。}}{75}{figure.7.3}\protected@file@percent }
\newlabel{fig:cycles}{{7.3}{75}{周期の模式図（トーラスの場合）。交叉数 $1$ の2つのサイクル $A$（赤）と $B$（青）の上で正則形式 $\Omega $ を積分したものが周期である。トーラスでは $\Omega = dz$ で、周期の比 $\tau = \int _B\Omega /\int _A\Omega $ が複素構造モジュライとなる。CY3では、$2(h^{2,1} + 1)$ 個の3サイクル $\{A_I, B^I\}$ の上で正則3形式を積分する。}{figure.7.3}{}}
\@writefile{toc}{\contentsline {paragraph}{例：トーラス（1次元のCalabi--Yau多様体）}{75}{section*.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces トーラスの2種類の変形。格子の基本平行四辺形（左）を相似に拡大するのがK\"ahler変形（中央）、形の比 $\tau $ を変えるのが複素構造変形（右）である。CY3でも同様に、計量の変形は「大きさ」（$h^{1,1}$ 個）と「形」（$h^{2,1}$ 個）に分かれる。}}{76}{figure.7.4}\protected@file@percent }
\newlabel{fig:T2-deformations}{{7.4}{76}{トーラスの2種類の変形。格子の基本平行四辺形（左）を相似に拡大するのがK\"ahler変形（中央）、形の比 $\tau $ を変えるのが複素構造変形（右）である。CY3でも同様に、計量の変形は「大きさ」（$h^{1,1}$ 個）と「形」（$h^{2,1}$ 個）に分かれる。}{figure.7.4}{}}
