\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces 主束 $P \to M$ と接続。各点の上にファイバー（$G$ と同型）が立っている。ファイバー方向の垂直部分空間 $V_p$ は自然に決まるが、水平部分空間 $H_p$ の選び方が接続である。底空間の曲線 $\gamma $ を、常に $H_p$ の方向に進むように持ち上げたものが水平リフト（並行移動）である。}}{39}{figure.4.3}\protected@file@percent }
\newlabel{fig:bundle}{{4.3}{39}{主束 $P \to M$ と接続。各点の上にファイバー（$G$ と同型）が立っている。ファイバー方向の垂直部分空間 $V_p$ は自然に決まるが、水平部分空間 $H_p$ の選び方が接続である。底空間の曲線 $\gamma $ を、常に $H_p$ の方向に進むように持ち上げたものが水平リフト（並行移動）である。}{figure.4.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.3}曲率と可積分条件：並行移動の経路依存性}{39}{section.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces ホロノミー。閉曲線 $\gamma $ に沿って水平リフトすると（点線は奥側）、一般には出発点 $p$ に戻らず、同じファイバー上の別の点 $p \cdot \mathrm   {Hol}_\gamma $ に到達する。このずれがホロノミーであり、小さなループでのずれを測ったものが曲率である。平坦接続では、ループを連続変形してもずれは変わらない。}}{40}{figure.4.4}\protected@file@percent }
\newlabel{fig:holonomy}{{4.4}{40}{ホロノミー。閉曲線 $\gamma $ に沿って水平リフトすると（点線は奥側）、一般には出発点 $p$ に戻らず、同じファイバー上の別の点 $p \cdot \mathrm {Hol}_\gamma $ に到達する。このずれがホロノミーであり、小さなループでのずれを測ったものが曲率である。平坦接続では、ループを連続変形してもずれは変わらない。}{figure.4.4}{}}
