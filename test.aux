\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Wu--Yangによるモノポールの記述。球面を北側のパッチ $U_N$（青）と南側のパッチ $U_S$（赤）で覆い、それぞれで滑らかなポテンシャルを用いる。$A_N$ を南極まで延長しようとすると特異線（Diracの弦）が現れるが、パッチを分ければ不要になる。2つのパッチの情報は、重なり（紫）での推移関数に集約される。}}{36}{figure.4.1}\protected@file@percent }
\newlabel{fig:wu-yang}{{4.1}{36}{Wu--Yangによるモノポールの記述。球面を北側のパッチ $U_N$（青）と南側のパッチ $U_S$（赤）で覆い、それぞれで滑らかなポテンシャルを用いる。$A_N$ を南極まで延長しようとすると特異線（Diracの弦）が現れるが、パッチを分ければ不要になる。2つのパッチの情報は、重なり（紫）での推移関数に集約される。}{figure.4.1}{}}
