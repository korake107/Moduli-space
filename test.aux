\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces ミラー対称性。$X$ 上のタイプIIA弦理論と $Y$ 上のタイプIIB弦理論が同等であり、$X$ のK\"ahlerモジュライ空間と $Y$ の複素構造モジュライ空間（およびその逆）が入れ替わる。世界面インスタントンの補正を含む左上の量を、古典的な周期積分で厳密に計算できる右上の量に翻訳できる。}}{79}{figure.7.6}\protected@file@percent }
\newlabel{fig:mirror}{{7.6}{79}{ミラー対称性。$X$ 上のタイプIIA弦理論と $Y$ 上のタイプIIB弦理論が同等であり、$X$ のK\"ahlerモジュライ空間と $Y$ の複素構造モジュライ空間（およびその逆）が入れ替わる。世界面インスタントンの補正を含む左上の量を、古典的な周期積分で厳密に計算できる右上の量に翻訳できる。}{figure.7.6}{}}
