\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces 推移関数 $t_{NS}(\phi ) = e^{in\phi }$ の巻き付き数。左：位相 $\arg t_{NS}$ は赤道を1周すると $2\pi n$ だけ増える。$t_{NS}$ が一価であるためには $n$ は整数でなければならず、$n$ は連続変形で変えられない。右：$n = 2$ の場合、赤道を1周すると $U(1)$ を2回まわる。}}{37}{figure.4.2}\protected@file@percent }
\newlabel{fig:winding}{{4.2}{37}{推移関数 $t_{NS}(\phi ) = e^{in\phi }$ の巻き付き数。左：位相 $\arg t_{NS}$ は赤道を1周すると $2\pi n$ だけ増える。$t_{NS}$ が一価であるためには $n$ は整数でなければならず、$n$ は連続変形で変えられない。右：$n = 2$ の場合、赤道を1周すると $U(1)$ を2回まわる。}{figure.4.2}{}}
